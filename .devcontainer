{
  "name": "TensorFlow GPU Dev Container",
  "image": "tensorflow/tensorflow:latest-gpu-jupyter",
  "runArgs": [
    "--gpus",
    "all"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "postCreateCommand": "pip install --upgrade pip && pip install pandas matplotlib"
}